{
  "name": "anteraja-pharma-android",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "type-check": "node ../node_modules/vue-tsc/bin/vue-tsc.js --noEmit -p tsconfig.json",
    "build:web": "node scripts/build.mjs",
    "sync": "npm run build:web && cap sync android",
    "preview": "node ../node_modules/vite/bin/vite.js preview --config vite.config.mjs --host 127.0.0.1 --port 5188 --strictPort",
    "open": "cap open android",
    "apk:debug": "node scripts/compile.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/dialog": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/geolocation": "8.2.3",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
